---
import SiteLayout from "../layouts/SiteLayout.astro";
import TOCResponsive from "../component/toc-responsive.astro";
import { getAllContent } from "../content";
import type { AnyEntry } from "../content";
import { entryPath, homePath, tagPath } from "../lib/paths";

// 技术文 + 单篇随笔走此路由；连载小说有独立的 novel/[novelSlug] 落地页，这里排除以免路由冲突。
export async function getStaticPaths() {
  const entries = (await getAllContent()).filter(
    (entry) => !(entry.collection === "novel" && entry.data.isNovel)
  );
  return entries.map((entry) => ({
    params: { path: `/${entry.collection}/${entry.slug}` },
    props: { entry },
  }));
}

const entry = Astro.props.entry as AnyEntry;
const { Content, headings } = await entry.render();

const tags = entry.data.tags ?? [];
---

<SiteLayout
  title={`${entry.data.title} - 太虚幻境`}
  description={entry.data.description}
  type="article"
  theme="article"
  date={entry.data.date}
  updated={entry.data.updated}
  author={entry.data.author}
  cover={entry.data.cover}
  tags={tags}
  canonicalPath={entryPath(entry)}
>
  <main class="page-container">
    <header class="article-header">
      <nav class="article-nav">
        <a href={homePath()} class="back-link">← 返回首页</a>
        <div>
          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <a href={tagPath(tag)} class="tag">{tag}</a>
              ))}
            </div>
          )}
        </div>
      </nav>
    </header>

    <div class="content-layout">
      <aside class="toc-sidebar">
        <TOCResponsive headings={headings} />
      </aside>
      <div class="article-content">
        <article>
          <Content />
        </article>
      </div>
    </div>
  </main>
</SiteLayout>

<style>
  body {
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
    color: var(--var_pitch-black);
    background-color: var(--var_background-color);
    background-image: url("../styles/border-text.svg");
    margin: 0;
    padding: 2rem;
  }

  .page-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .content-layout {
    display: flex;
    gap: 2rem;
  }

  .toc-sidebar {
    flex: 0 0 300px;
    position: sticky;
    top: 2rem;
    height: calc(100vh - 4rem);
    max-height: calc(100vh - 4rem);
    overflow: hidden;
  }

  .article-content {
    flex: 1;
    max-width: 800px;
    background-color: var(--var_background-color);
    padding: 2rem;
    border: var(--var_border-width) solid var(--var_pitch-black);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    position: relative;
  }

  .article-header {
    border-bottom: var(--var_border-width) solid var(--var_pitch-black);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background-color: var(--var_red);
    color: var(--var_off-white);
    padding: 0.2rem 0.5rem;
    border-radius: 0.2rem;
    font-size: var(--step--1);
    text-decoration: none;
    display: inline-block;
    transition: all 0.2s ease;
  }

  .tag:hover {
    background-color: var(--var_pitch-black);
    transform: translateY(-1px);
  }

  .article-nav {
    margin-top: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .back-link {
    color: var(--var_red);
    text-decoration: none;
    font-weight: bold;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  /* 响应式布局 */
  @media (max-width: 1199px) {
    .content-layout {
      flex-direction: column;
    }

    .toc-sidebar {
      flex: none;
      position: static;
      height: auto;
      max-height: none;
      overflow: visible;
      order: -1;
    }

    .article-content {
      max-width: none;
    }
  }

  @media (width < 768px) {
    body {
      padding: 1rem;
    }

    .page-container {
      max-width: none;
    }

    .content-layout {
      gap: 1rem;
    }

    .article-content {
      padding: 1rem;
    }
  }
</style>
