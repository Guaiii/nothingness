---
import NovelLayout from "../../../layouts/NovelLayout.astro";
import { getNovels, getChaptersOfNovel } from "../../../content";
import { chapterPath, chapterRouteSlug } from "../../../lib/paths";

export async function getStaticPaths() {
  const novels = await getNovels();
  return novels.map((novel) => ({
    params: { novelSlug: novel.slug },
    props: { novel },
  }));
}

const novel = Astro.props.novel;
const { Content } = await novel.render();
const realChapters = await getChaptersOfNovel(novel.slug);
const firstChapter = realChapters[0] ?? null;
---

<NovelLayout
  novel={novel}
  pageTitle={novel.data.title}
  type="book"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Book",
    name: novel.data.title,
    ...(novel.data.author ? { author: { "@type": "Person", name: novel.data.author } } : {}),
    ...(novel.data.description ? { description: novel.data.description } : {}),
    inLanguage: "zh-CN",
  }}
>
  <article class="novel-article">
    <div class="novel-meta">
      <h1 class="novel-title">{novel.data.title}</h1>
      {novel.data.author && <p class="novel-author">作者：{novel.data.author}</p>}
      {novel.data.status && (
        <span class={`novel-status status-${novel.data.status}`}>{novel.data.status}</span>
      )}
    </div>

    <div class="novel-body">
      <Content />
    </div>

    {firstChapter && (
      <div class="chapter-navigation">
        <h3>开始阅读</h3>
        <a href={chapterPath(novel.slug, chapterRouteSlug(firstChapter.slug))} class="start-reading-btn">
          开始阅读第一章
        </a>
      </div>
    )}
  </article>
</NovelLayout>

<style>
  .novel-article {
    flex: 1;
    padding: 2rem;
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }

  .novel-meta {
    margin-bottom: 3rem;
    text-align: center;
    border-bottom: var(--var_border-width) solid var(--var_pitch-black);
    padding-bottom: 2rem;
  }

  .novel-title {
    font-size: var(--step-4);
    font-weight: bold;
    margin-bottom: 1rem;
    color: var(--var_pitch-black);
  }

  .novel-author {
    font-size: var(--step-1);
    color: var(--var_red);
    margin-bottom: 1rem;
  }

  .novel-status {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: bold;
  }

  .status-连载中 {
    background: var(--var_red);
    color: var(--var_off-white);
  }

  .status-已完结 {
    background: var(--var_pitch-black);
    color: var(--var_off-white);
  }

  .status-暂停 {
    background: var(--var_border-color);
    color: var(--var_pitch-black);
  }

  .novel-body {
    line-height: 1.8;
    font-size: var(--step-0);
  }

  .chapter-navigation {
    margin-top: 3rem;
    padding: 2rem;
    border: var(--var_border-width) solid var(--var_pitch-black);
    border-radius: 8px;
    text-align: center;
    background: var(--var_off-white);
    position: relative;
    z-index: 10;
  }

  .chapter-navigation h3 {
    margin-bottom: 1rem;
    color: var(--var_pitch-black);
    font-size: var(--step-1);
  }

  .start-reading-btn {
    display: inline-block;
    padding: 1rem 2rem;
    background: var(--var_red);
    color: var(--var_off-white);
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    transition: all 0.2s ease;
    border: var(--var_border-width) solid var(--var_red);
  }

  .start-reading-btn:hover {
    background: var(--var_pitch-black);
    border-color: var(--var_pitch-black);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .novel-article {
      padding: 1rem;
    }

    .novel-title {
      font-size: var(--step-3);
    }
  }
</style>
