---
export interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;

// 过滤掉主标题，并按二级标题组织成出版物式目录分组。
const tocHeadings = headings.filter((heading) => heading.depth > 1 && heading.depth <= 4);
const tocGroups = tocHeadings.reduce<Array<{
  section: (typeof tocHeadings)[number];
  children: Array<(typeof tocHeadings)[number]>;
}>>((groups, heading) => {
  if (heading.depth === 2 || groups.length === 0) {
    groups.push({ section: heading, children: [] });
  } else {
    groups.at(-1)?.children.push(heading);
  }
  return groups;
}, []);
---

{tocHeadings.length > 0 && (
  <div class="toc-container">
    <button class="toc-toggle" aria-label="切换目录" aria-expanded="false" aria-controls="toc-nav">
      <span class="toc-toggle-text">目录</span>
      <span class="toc-toggle-arrow" aria-hidden="true"></span>
    </button>

    <nav class="toc" id="toc-nav" aria-label="文章目录">
      <div class="toc-header">
        <h3 class="toc-title">目录</h3>
        <button class="toc-close" aria-label="关闭目录">×</button>
      </div>

      <ol class="toc-list">
        {tocGroups.map((group, index) => (
          <li class:list={["toc-group", index === 0 && group.children.length > 0 && "is-open"]}>
            <div class="toc-section-row">
              <a
                href={`#${group.section.slug}`}
                class="toc-link toc-section-link"
                data-target={group.section.slug}
              >
                <span class="toc-index">{String(index + 1).padStart(2, "0")}</span>
                <span class="toc-text">{group.section.text}</span>
              </a>
              {group.children.length > 0 && (
                <button
                  class="toc-section-toggle"
                  type="button"
                  aria-label={`折叠或展开“${group.section.text}”的小章节`}
                  aria-controls={`toc-children-${index}`}
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <span class="toc-section-chevron" aria-hidden="true"></span>
                </button>
              )}
            </div>
            {group.children.length > 0 && (
              <ol class="toc-children" id={`toc-children-${index}`} hidden={index !== 0}>
                {group.children.map((heading) => (
                  <li class={`toc-item toc-level-${heading.depth}`}>
                    <a href={`#${heading.slug}`} class="toc-link toc-child-link" data-target={heading.slug}>
                      <span class="toc-text">{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>

      <div class="toc-progress" aria-hidden="true">
        <div class="toc-progress-bar"></div>
      </div>
    </nav>

    <div class="toc-overlay"></div>
  </div>
)}

<style>
  .toc-container {
    position: relative;
    z-index: 100;
  }

  .toc-toggle {
    display: none;
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1001;
    align-items: center;
    gap: 0.55rem;
    padding: 0.48rem 0.72rem;
    border: 1px solid var(--var_pitch-black);
    border-radius: 0;
    background: var(--var_background-color);
    color: var(--var_pitch-black);
    font-family: "Songti SC", "STSong", serif;
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
  }

  .toc-toggle-arrow,
  .toc-section-chevron {
    display: block;
    width: 0;
    height: 0;
    border-right: 0.3rem solid transparent;
    border-left: 0.3rem solid transparent;
    border-top: 0.42rem solid currentColor;
  }

  .toc-toggle.active .toc-toggle-arrow,
  .toc-section-toggle[aria-expanded="true"] .toc-section-chevron {
    border-top: 0;
    border-bottom: 0.42rem solid currentColor;
  }

  .toc {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 300px;
    height: calc(100vh - 4rem);
    max-height: calc(100vh - 4rem);
    padding: 0.35rem 0 0;
    overflow: hidden;
    color: var(--var_pitch-black);
    font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif;
  }

  .toc-header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 1.35rem;
    padding-left: 2.75rem;
  }

  .toc-title {
    margin: 0;
    padding: 0.34rem 0.9rem;
    border: 1px solid var(--var_pitch-black);
    background: var(--var_background-color);
    color: var(--var_pitch-black);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.25;
  }

  .toc-close {
    display: none;
    margin-left: auto;
    border: 0;
    background: none;
    color: var(--var_pitch-black);
    font-size: 1.4rem;
    cursor: pointer;
  }

  .toc-list,
  .toc-children {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-group {
    position: relative;
    padding: 0 0 1rem 2.75rem;
  }

  .toc-group + .toc-group {
    padding-top: 0.15rem;
  }

  .toc-group::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--var_pitch-black) 60%, transparent);
  }

  .toc-group:last-child::before {
    bottom: auto;
    height: 1.25rem;
  }

  .toc-link {
    color: var(--var_pitch-black);
    text-decoration: none;
  }

  .toc-section-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.15rem;
  }

  .toc-section-row:has(.toc-section-link:only-child) {
    grid-template-columns: minmax(0, 1fr);
  }

  .toc-section-link {
    position: relative;
    display: grid;
    grid-template-columns: 2.15rem minmax(0, 1fr);
    width: 100%;
    min-height: 2.45rem;
    border: 1px solid var(--var_pitch-black);
    background: var(--var_pitch-black);
    color: var(--var_background-color);
    line-height: 1.35;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .toc-section-link::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 100%;
    width: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--var_pitch-black) 60%, transparent);
  }

  .toc-index {
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid color-mix(in srgb, var(--var_background-color) 65%, transparent);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .toc-section-link .toc-text {
    display: block;
    padding: 0.48rem 0.68rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    overflow-wrap: anywhere;
  }

  .toc-section-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.15rem;
    border: 1px solid var(--var_pitch-black);
    border-left: 0;
    border-radius: 0;
    background: var(--var_pitch-black);
    color: var(--var_background-color);
    font: inherit;
    cursor: pointer;
  }

  .toc-section-toggle:hover,
  .toc-section-toggle:focus-visible {
    background: var(--var_red);
    color: var(--var_off-white);
    outline: none;
  }

  .toc-children {
    position: relative;
    margin: 0.34rem 0 0 1.05rem;
    padding: 0.3rem 0.35rem 0.34rem 0.85rem;
    border-left: 1px solid color-mix(in srgb, var(--var_background-color) 55%, transparent);
    background: var(--var_pitch-black);
    color: var(--var_background-color);
  }

  .toc-children[hidden] {
    display: none;
  }

  .toc-item {
    position: relative;
  }

  .toc-item::before {
    content: "";
    position: absolute;
    top: 0.92rem;
    right: 100%;
    width: 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--var_background-color) 55%, transparent);
  }

  .toc-child-link {
    display: block;
    margin-left: 0.35rem;
    padding: 0.3rem 0.42rem 0.3rem 0.7rem;
    border-left: 2px solid transparent;
    color: var(--var_background-color);
    font-size: 0.68rem;
    line-height: 1.45;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .toc-level-4 .toc-child-link {
    margin-left: 0.75rem;
    padding-left: 0.8rem;
    color: color-mix(in srgb, var(--var_background-color) 78%, transparent);
  }

  .toc-section-link:hover,
  .toc-section-link.active {
    background: var(--var_red);
    color: var(--var_off-white);
  }

  .toc-child-link:hover,
  .toc-child-link.active {
    border-left-color: var(--var_off-white);
    background: color-mix(in srgb, var(--var_off-white) 12%, transparent);
    color: var(--var_off-white);
  }

  .toc-progress {
    position: relative;
    z-index: 5;
    flex: 0 0 auto;
    height: 0.42rem;
    margin-top: 0.65rem;
    padding: 0.14rem 0;
    background: var(--var_background-color);
    box-shadow: 0 -1px 0 color-mix(in srgb, var(--var_pitch-black) 18%, transparent);
  }

  .toc-progress-bar {
    width: 0;
    height: 0.14rem;
    background: var(--var_red);
    transition: width 0.2s ease;
  }

  .toc-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .toc-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 1199px) {
    .toc {
      display: none;
    }

    .toc-toggle {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .toc {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: block;
      width: 100%;
      max-width: none;
      height: 100vh;
      max-height: 100vh;
      padding: 1rem;
      overflow: hidden;
      background: var(--var_background-color);
      transform: translateY(-100%);
      transition: transform 0.25s ease;
    }

    .toc.active {
      transform: translateY(0);
    }

    .toc-header {
      position: sticky;
      top: 0;
      z-index: 1;
      padding-bottom: 1rem;
      background: var(--var_background-color);
    }

    .toc-close {
      display: block;
    }

    .toc-list {
      max-height: none;
      overflow-y: auto;
    }

    .toc-group {
      padding-left: 2.75rem;
    }

    .toc-section-link .toc-text,
    .toc-child-link {
      font-size: var(--step--1);
    }

    .toc-overlay {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .toc-toggle {
      top: 0.5rem;
      right: 0.5rem;
    }

    .toc-group {
      display: block;
      padding-left: 1rem;
    }

    .toc-group::before {
      left: 1rem;
    }

    .toc-section-link {
      width: fit-content;
      max-width: calc(100% - 1rem);
    }

    .toc-children {
      margin-left: 2rem;
    }
  }

  @media (min-width: 1200px) {
    .toc-toggle {
      display: none;
    }
  }
</style>

<script>
  import { createOverlayPanel } from "../lib/overlay-panel";

  document.querySelectorAll<HTMLElement>(".toc-container").forEach((root) => {
    const trigger = root.querySelector<HTMLElement>(".toc-toggle");
    const panel = root.querySelector<HTMLElement>(".toc");
    const overlay = root.querySelector<HTMLElement>(".toc-overlay");
    const closer = root.querySelector<HTMLElement>(".toc-close");
    const progressBar = root.querySelector<HTMLElement>(".toc-progress-bar");
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>(".toc-link"));
    const sectionToggles = Array.from(root.querySelectorAll<HTMLButtonElement>(".toc-section-toggle"));
    if (!trigger || !panel) return;

    const handle = createOverlayPanel({
      trigger,
      panel,
      overlay,
      closers: closer ? [closer] : [],
      closeAbove: 1199,
    });

    sectionToggles.forEach((button) => {
      button.addEventListener("click", () => {
        const controls = button.getAttribute("aria-controls");
        const children = controls ? document.getElementById(controls) : null;
        if (!(children instanceof HTMLOListElement)) return;

        const willOpen = button.getAttribute("aria-expanded") !== "true";
        button.setAttribute("aria-expanded", String(willOpen));
        children.hidden = !willOpen;
        button.closest(".toc-group")?.classList.toggle("is-open", willOpen);
      });
    });

    // 点击目录链接后，在移动端关闭抽屉（延迟以等待滚动）
    links.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth <= 1199) window.setTimeout(() => handle.close(), 300);
      });
    });

    // 高亮当前章节
    function updateActiveLink(): void {
      const headings = document.querySelectorAll("h2, h3, h4, h5, h6");
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      let current = "";
      headings.forEach((heading) => {
        if (heading.getBoundingClientRect().top <= 100) current = heading.id;
      });
      links.forEach((link) => {
        link.classList.toggle("active", link.getAttribute("data-target") === current);
      });
      void scrollTop;
    }

    function updateProgress(): void {
      if (!progressBar) return;
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    }

    let ticking = false;
    function onScroll(): void {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActiveLink();
          updateProgress();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    updateActiveLink();
    updateProgress();
  });
</script>
