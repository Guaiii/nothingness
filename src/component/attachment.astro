---
// 下载附件卡片：<Attachment href="/downloads/foo.pdf" name="说明书" size="1.2 MB" />。
// 同源文件随站点托管（小文件，见 ADR-0005 阈值）；外链（http/https）视为对象存储/CDN，新开标签。
import { assetPath } from "../lib/paths";

export interface Props {
  href: string;
  name: string;
  size?: string;
  /** 文件类型提示，如 PDF / ZIP */
  ext?: string;
  note?: string;
}
const { href, name, size, ext, note } = Astro.props;
const external = /^https?:\/\//i.test(href);
const url = external ? href : assetPath(href);
---

<a
  class:list={["attachment", external ? "is-external" : null]}
  href={url}
  {...external ? { target: "_blank", rel: "noopener" } : { download: true }}
>
  <span class="attachment-icon" aria-hidden="true">
    {ext ? ext.toUpperCase().slice(0, 4) : "FILE"}
  </span>
  <span class="attachment-body">
    <span class="attachment-name">{name}</span>
    <span class="attachment-meta">
      {[size, external ? "站外下载" : "点击下载", note].filter(Boolean).join(" · ")}
    </span>
  </span>
  <span class="attachment-arrow" aria-hidden="true">{external ? "↗" : "↓"}</span>
</a>
