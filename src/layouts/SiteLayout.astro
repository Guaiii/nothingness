---
// 站点基础布局：统一 head（SEO/OG/JSON-LD）、favicon 与样式引入。
// 不改动既有视觉：header/footer/正文结构仍由各页面通过 slot 提供。
// index.css 内部 @import 了 global.css；article 主题单独加载其余表，避免重复 reset。
import globalCss from "../styles/global.css?url";
import indexCss from "../styles/index.css?url";
import codeThemeCss from "../styles/code-theme.css?url";
import mdxThemeCss from "../styles/mdx-theme.css?url";
import { assetPath, homePath } from "../lib/paths";

export interface Props {
  title: string;
  description?: string;
  /** OG/内容类型：website / article / book（小说落地页） */
  type?: "website" | "article" | "book";
  /** 样式组合：site=首页/标签(index.css)；article=正文(global+code+mdx)；series=集合(global+mdx) */
  theme?: "site" | "article" | "series";
  /** ISO 发布时间 / 更新时间，用于 article 元信息与 JSON-LD */
  date?: Date;
  updated?: Date;
  author?: string;
  cover?: string;
  /** canonical 相对路径（站点内路径），默认用当前 URL */
  canonicalPath?: string;
  tags?: string[];
  /** robots 指令，如 404 页用 noindex */
  robots?: string;
  /** 额外结构化数据对象，将序列化为 JSON-LD */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  type = "website",
  theme = "site",
  date,
  updated,
  author,
  cover,
  canonicalPath,
  tags = [],
  robots,
  jsonLd,
} = Astro.props;

// 与原页面逐一对齐的样式组合，视觉不改变
const themeStyles =
  theme === "article"
    ? [globalCss, codeThemeCss, mdxThemeCss]
    : theme === "series"
      ? [globalCss, mdxThemeCss]
      : [indexCss];

const site = (Astro.site?.href ?? "/").replace(/\/+$/, "");
const canonical = canonicalPath
  ? `${site}${canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`}`
  : Astro.url.href;
const coverUrl = cover ? new URL(cover.startsWith("/") ? cover : `/${cover}`, site).href : undefined;

const baseJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": type === "article" ? "BlogPosting" : "WebSite",
  headline: title,
  ...(description ? { description } : {}),
  url: canonical,
  ...(coverUrl ? { image: coverUrl } : {}),
  ...(type === "article"
    ? {
        datePublished: date?.toISOString(),
        dateModified: (updated ?? date)?.toISOString(),
        ...(author ? { author: { "@type": "Person", name: author } } : {}),
        keywords: tags.join(", "),
      }
    : {}),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={assetPath("favicon.svg")} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {coverUrl && <meta property="og:image" content={coverUrl} />}
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content={coverUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {coverUrl && <meta name="twitter:image" content={coverUrl} />}

    {date && <meta property="article:published_time" content={date.toISOString()} />}
    {(updated ?? date) && (
      <meta property="article:modified_time" content={(updated ?? date)!.toISOString()} />
    )}
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <link rel="alternate" type="application/rss+xml" title="太虚幻境" href={`${site}/rss.xml`} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd ?? baseJsonLd)}
    />

    {themeStyles.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
  </head>
  <body>
    <a href={homePath()} class="skip-link">跳到主内容</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 2000;
    background: var(--var_pitch-black);
    color: var(--var_off-white);
    padding: 0.5rem 1rem;
  }
  .skip-link:focus {
    left: 1rem;
  }
</style>
