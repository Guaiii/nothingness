# 复制为 .env 后按实际填写；.env 已被 .gitignore 忽略，不要提交。

# 服务器主机（IP 或域名）
DEPLOY_HOST=your-server-ip-or-domain
# 用于 SSH / rsync 的系统用户
DEPLOY_USER=deploy
# 服务器上 Nginx 站点根目录（rsync 会把 dist/ 内容同步到这里）
DEPLOY_PATH=/var/www/your-domain.com
# SSH 端口，默认 22
SSH_PORT=22

# 注意：正式根域名请同步修改 astro.config.mjs 的 SITE_URL（用于 canonical / sitemap / OG）。
