# 太虚幻境 · 服务器 Nginx 站点配置示例
#
# 用法：
#   sudo cp docs/nginx.conf.example /etc/nginx/sites-available/your-domain.com
#   # 将下方 your-domain.com 全部替换为正式域名后：
#   sudo ln -s /etc/nginx/sites-available/your-domain.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# 对应 .env：DEPLOY_PATH=/var/www/your-domain.com

# HTTP：全部 301 到 HTTPS（certbot 也会自动维护这条跳转）
server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com;

    # certbot 续签校验用
    location /.well-known/acme-challenge/ {
        root /var/www/your-domain.com;
    }

    location / {
        return 301 https://your-domain.com$request_uri;
    }
}

# HTTPS 主站
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.com;

    # certbot 签好后会自动写入这两行；此处先占位
    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

    root /var/www/your-domain.com;
    index index.html;

    # Astro 以 directory 格式输出（/about/ -> /about/index.html）
    location / {
        try_files $uri $uri/ $uri.html /404.html;
    }

    # 静态资源长缓存（文件名带内容哈希）
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 图片长缓存（带宽保护：正文/封面图可长期缓存）
    location ~* \.(?:png|jpg|jpeg|gif|webp|avif|svg|ico)$ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # 下载附件：中等缓存并提示浏览器下载。仅放小文件（ADR-0005 的 ~10MB 阈值）；
    # 大文件请放对象存储/CDN，正文里只放外链，避免占满轻量服务器带宽。
    location /downloads/ {
        expires 7d;
        add_header Cache-Control "public";
        add_header Content-Disposition "attachment";
    }

    # sitemap / robots / RSS / llms 文本不做长缓存
    location ~* \.(xml|txt)$ {
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/xml text/xml application/rss+xml image/svg+xml;
    gzip_min_length 1024;

    # 自定义 404 页
    error_page 404 /404.html;
}

# www 跳转到根域名（避免重复内容，利于 SEO）
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

    return 301 https://your-domain.com$request_uri;
}
